# ─── Better Personal Finance — Production Environment ──────────────────────
# Copy this file to .env, fill in every value, then `docker compose up -d`.
# NEVER commit .env to version control — it is listed in .gitignore.
#
# ── Generating secrets ───────────────────────────────────────────────────────
# Random hex string (256-bit) — good for all SECRET / KEY fields:
#   openssl rand -hex 32
# Random alphanumeric password — good for database/Redis passwords:
#   openssl rand -base64 32 | tr -d '/+=\n' | head -c 32
# Node.js one-liner (no openssl required):
#   node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Deployment mode ───────────────────────────────────────────────────────────
# Standalone (bundled Caddy handles TLS on ports 80/443):
#   docker compose up -d
#   Set DOMAIN below. WEB_ORIGIN and WEB_PORT are not required.
#
# Behind an external reverse proxy (nginx, Traefik, Caddy, etc.):
#   docker compose -f docker-compose.yml -f docker-compose.external-proxy.yml up -d
#   Set WEB_ORIGIN and WEB_PORT below. DOMAIN is not required.

# Domain name — used by the bundled Caddyfile for TLS and routing (standalone mode).
DOMAIN=finance.example.com

# Published image repository and tag.
#
# GitHub Container Registry (default, docker-compose.yml):
#   Replace <your-github-username> with your GitHub username.
GHCR_REPO=<your-github-username>/better-personal-finance
IMAGE_TAG=latest
#
# Docker Hub (docker-compose.dockerhub.yml — standalone):
#   Replace <your-dockerhub-username> with your Docker Hub username.
#   docker compose -f docker-compose.dockerhub.yml up -d
DOCKERHUB_REPO=<your-dockerhub-username>

# Full public origin the browser uses to reach the app (scheme + host, no trailing slash).
# Standalone:      leave unset — derived automatically from DOMAIN (https://${DOMAIN}).
# External proxy:  set this explicitly to match your proxy's public URL.
# WEB_ORIGIN=https://finance.example.com

# Host port the web container is exposed on (external proxy mode only).
# Your proxy should forward HTTP traffic to http://<docker-host>:${WEB_PORT}
# WEB_PORT=3000

# Cookie / CSRF signing key — generate with: openssl rand -hex 32
APP_SECRET=

# AES encryption key for TOTP secrets at rest — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Session signing secret — generate with: openssl rand -hex 32
AUTH_SECRET=
SESSION_MAX_AGE_SECONDS=3600

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Host matches the service name in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finance
POSTGRES_USER=finance_user
# Generate with: openssl rand -base64 32 | tr -d '/+=\n' | head -c 32
POSTGRES_PASSWORD=

# DATABASE_URL is composed automatically by docker-compose.yml from the
# POSTGRES_* variables above. You only need to set it here if you are
# connecting to the database from outside Docker Compose (e.g. Prisma Studio).
# DATABASE_URL=postgresql://finance_user:yourpassword@localhost:5432/finance?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
# Host matches the service name in docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -base64 32 | tr -d '/+=\n' | head -c 32
REDIS_PASSWORD=

# REDIS_URL is composed automatically by docker-compose.yml from the
# REDIS_* variables above. You only need to set it here if connecting
# from outside Docker Compose.
# REDIS_URL=redis://:yourpassword@localhost:6379

# ── Email (optional — for future password-reset feature) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Store the SMTP password securely; do not hard-code it here in shared configs
SMTP_PASS=
SMTP_FROM=noreply@finance.example.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
